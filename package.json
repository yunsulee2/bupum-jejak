    "assets:interaction": "blender --background assets/pc-lab-source.blend --python tools/update_interaction_proxy.py"
  },
  "dependencies": {
    "three": "^0.179.1"
  },
  "devDependencies": {
    "vite": "^7.1.1"
  }
}
